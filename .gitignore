# ── Secrets ────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Claude Code (harness-specific — each user runs make-claude-md locally) ─
# CLAUDE.md and run.sh/run.ps1 ARE committed — they are the shared agent config.
# Only exclude the user-local settings override.
.claude/settings.local.json

# ── Other harness directories ───────────────────────────────────────────────
# Each harness generates its own config directory. Keep those local.
# If you use a harness not listed here, add its directory to this section.
.cursor/
.aider*
.continue/
.copilot/
.windsurf/
.codex/
.gemini/

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

